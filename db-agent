#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

VENV_PYTHON="$DIR/.venv/bin/python"
if [ ! -x "$VENV_PYTHON" ]; then
    bash "$DIR/setup.sh"
fi

exec "$VENV_PYTHON" -m db_agent.cli "$@"
