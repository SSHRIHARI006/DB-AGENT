# Copy this file to .env and fill in the provider key you want to test.
groq_api_key=
ollama-cloud_api_key=
gemini_api_key=
openrouter_api_key=
nvidia_api_key=

# Demo mode: comma-separated key list for round-robin rotation per query.
# Falls back to the single-key vars above if unset.
# DEMO_GROQ_KEYS=key1,key2,key3
# DEMO_GEMINI_KEYS=key1,key2
# DEMO_OPENROUTER_KEYS=key1,key2

# Optional: Langfuse observability (tracing is a no-op without these).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
